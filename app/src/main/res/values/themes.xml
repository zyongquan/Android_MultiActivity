<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主题：带 ActionBar，标题栏显示“姓名+学号”，各页面用副标题区分任务 -->
    <style name="Theme.MultiActivity" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <!-- 统一的圆角按钮样式，颜色由各按钮的 backgroundTint 指定 -->
    <style name="Widget.MultiActivity.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
